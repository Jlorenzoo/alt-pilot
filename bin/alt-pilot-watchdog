#!/usr/bin/env bash
# Restore Minecraft sessions that reached the server and later lost their TCP
# connection while the launcher JVM remained alive at the multiplayer menu.
set -Eeuo pipefail

MC_SERVER=eu.mc-complex.com
if [[ -r /etc/alt-pilot/options.env ]]; then
  # shellcheck disable=SC1091
  source /etc/alt-pilot/options.env
fi
server_port=25565
[[ "$MC_SERVER" == *:* ]] && server_port="${MC_SERVER##*:}"
[[ "$server_port" =~ ^[0-9]+$ ]] && (( server_port >= 1 && server_port <= 65535 )) || { echo "Invalid Minecraft server port: $server_port" >&2; exit 1; }
if [[ -n "${STARTUP_RETRY_SECONDS:-}" && ! "$STARTUP_RETRY_SECONDS" =~ ^[1-9][0-9]{0,4}$ ]]; then
  echo "Invalid startup retry interval" >&2
  exit 1
fi
state_dir="${RUNTIME_DIRECTORY:-/run/alt-pilot-watchdog}"
umask 077
mkdir -p "$state_dir"

unit_for_slot() {
  if [[ "$1" == 1 ]]; then printf '%s\n' alt-pilot.service; else printf 'alt-pilot@%s.service\n' "$1"; fi
}

socket_pids="$(ss -Hntp state established "( dport = :$server_port )" 2>/dev/null \
  | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u || true)"

for slot in {1..10}; do
  # Slots 1 and 2 are always installed; higher slots only exist after an
  # isolated MCC profile has been created.
  if (( slot > 2 )) && [[ ! -d "/home/mc/slots/${slot}" ]]; then
    continue
  fi
  unit="$(unit_for_slot "$slot")"
  connected_marker="$state_dir/connected-${slot}"
  candidate_marker="$state_dir/candidate-${slot}"
  miss_marker="$state_dir/misses-${slot}"
  retry_marker="$state_dir/startup-retry-${slot}"
  properties="$(systemctl show "$unit" -p LoadState -p ActiveState -p UnitFileState \
    -p ActiveEnterTimestampMonotonic -p InactiveEnterTimestampMonotonic -p ControlGroup 2>/dev/null || true)"
  [[ "$(sed -n 's/^LoadState=//p' <<<"$properties")" == loaded ]] || continue
  active="$(sed -n 's/^ActiveState=//p' <<<"$properties")"
  enabled="$(sed -n 's/^UnitFileState=//p' <<<"$properties")"
  active_mono="$(sed -n 's/^ActiveEnterTimestampMonotonic=//p' <<<"$properties")"
  cgroup="$(sed -n 's/^ControlGroup=//p' <<<"$properties")"
  [[ "$active_mono" =~ ^[0-9]+$ ]] || active_mono=0

  # A failed service is different from a deliberate stop (inactive). Recover
  # failures as a second line of defense if systemd ever exhausts its retries.
  if [[ "$active" == failed && ( "$enabled" == enabled || "$enabled" == enabled-runtime ) ]]; then
    failed_mono="$(sed -n 's/^InactiveEnterTimestampMonotonic=//p' <<<"$properties")"
    now_mono="$(awk '{printf "%.0f", $1 * 1000000}' /proc/uptime)"
    if [[ "$failed_mono" =~ ^[0-9]+$ && "$now_mono" =~ ^[0-9]+$ ]] \
      && (( now_mono - failed_mono >= 120000000 )); then
      logger -t alt-pilot-watchdog "Account $slot service failed; rearming automatic recovery for $unit"
      if systemctl reset-failed "$unit"; then
        systemctl start --no-block "$unit" || logger -t alt-pilot-watchdog "Account $slot recovery could not be queued"
      fi
    fi
  fi

  if [[ "$active" != active || "$active_mono" -eq 0 ]]; then
    rm -f "$connected_marker" "$candidate_marker" "$miss_marker"
    if [[ "$active" == inactive ]]; then rm -f "$retry_marker"; fi
    continue
  fi

  now_mono="$(awk '{printf "%.0f", $1 * 1000000}' /proc/uptime)"
  age=$(( (now_mono - active_mono) / 1000000 ))
  edition="$(jq -r '.edition // "java"' "/home/mc/slots/${slot}/account.json" 2>/dev/null || true)"
  startup_retry="${STARTUP_RETRY_SECONDS:-120}"
  connected=false
  if [[ -n "$cgroup" && -r "/sys/fs/cgroup${cgroup}/cgroup.procs" ]]; then
    while read -r process_pid; do
      if grep -qx "$process_pid" <<<"$socket_pids"; then
        connected=true
        break
      fi
    done < "/sys/fs/cgroup${cgroup}/cgroup.procs"
  fi

  if [[ "$edition" == bedrock ]]; then
    startup_retry="${STARTUP_RETRY_SECONDS:-240}"
    connected=false
    bedrock_state="$(/usr/local/bin/afk-bedrock-connected "$slot" "$cgroup" --status)" || bedrock_state=disconnected
    if [[ "$bedrock_state" == connected ]]; then connected=true; fi
    if [[ "$bedrock_state" == delayed ]]; then
      # A stale JavaScript heartbeat is not a server disconnect. Give a busy
      # event loop time to recover without destroying the live WebRTC session.
      rm -f "$miss_marker"
      continue
    fi
  fi

  # During login a TCP socket may exist without the client reaching Minecraft.
  # Once the launch marker leaves the recent log, don't require it for old sessions.
  if [[ "$edition" != bedrock && "$(cat "$connected_marker" 2>/dev/null || true)" != "$active_mono" ]]; then
    log_file=/opt/alt-pilot/logs/afk.log
    if [[ "$slot" != 1 ]]; then log_file="/opt/alt-pilot/logs/afk-${slot}.log"; fi
    recent="$(tail -n 500 "$log_file" 2>/dev/null | tac | sed '/\[ALT-PILOT\] MCC startup began/q' | tac || true)"
    if [[ "$recent" == *'[ALT-PILOT] MCC startup began'* && "$recent" != *'Server was successfully joined'* ]]; then
      connected=false
    fi
    if [[ "$connected" == false && "$recent" == *'[ALT-PILOT] MCC startup began'* ]] && (( age < 1200 )); then
      # Let MCC's device code expire on its own instead of replacing it after two minutes.
      last_login_event="$(grep -E 'Waiting for authentication to complete|Microsoft authenticate failed:|Login failed :|Using Minecraft version|Unknown or not supported MC version|Checking if server is running Forge|Retrieving Server Info' <<<"$recent" | tail -n 1 || true)"
      if [[ "$last_login_event" == *'Waiting for authentication to complete'* ]]; then
        continue
      fi
    fi
  fi

  # Watch for the server's promise to return the current player after a restart.
  # Preserve that session while the promise is current, even if its heartbeat pauses.
  server_host="${MC_SERVER%%:*}"
  if [[ "${server_host,,}" == mc-complex.com || "${server_host,,}" == *.mc-complex.com ]] &&
    timeout 5 /usr/bin/python3 /usr/local/sbin/alt-pilot-hub-recovery.py "$slot" "$active_mono"; then
    rm -f "$miss_marker"
    continue
  fi

  if [[ "$connected" == true ]]; then
    rm -f "$miss_marker" "$retry_marker"
    if [[ "$(cat "$connected_marker" 2>/dev/null || true)" == "$active_mono" ]]; then
      rm -f "$candidate_marker"
      continue
    fi

    candidate_start=""; samples=0
    if [[ -r "$candidate_marker" ]]; then
      read -r candidate_start samples < "$candidate_marker" || true
    fi
    [[ "$candidate_start" == "$active_mono" && "$samples" =~ ^[0-9]+$ ]] || samples=0
    samples=$((samples + 1))
    if (( samples >= 3 )); then
      printf '%s\n' "$active_mono" > "$connected_marker"
      rm -f "$candidate_marker"
      logger -t alt-pilot-watchdog "Account $slot has a stable server connection; recovery armed"
    else
      printf '%s %s\n' "$active_mono" "$samples" > "$candidate_marker"
    fi

    continue
  fi

  # Back off repeated startup stalls during outages or resource contention.
  if [[ "$(cat "$connected_marker" 2>/dev/null || true)" != "$active_mono" ]]; then
    rm -f "$candidate_marker" "$miss_marker"
    retry_session=""; retries=0
    if [[ -r "$retry_marker" ]]; then read -r retry_session retries < "$retry_marker" || true; fi
    [[ "$retries" =~ ^[0-3]$ ]] || retries=0
    retry_after=$(( startup_retry * (1 << retries) ))
    if (( startup_retry <= 1200 && retry_after > 1200 )); then retry_after=1200; fi
    if (( age >= retry_after )) && [[ "$retry_session" != "$active_mono" ]]; then
      logger -t alt-pilot-watchdog "Account $slot did not finish startup within ${retry_after}s; retrying $unit"
      if systemctl try-restart --no-block "$unit"; then
        if (( retries < 3 )); then retries=$((retries + 1)); fi
        printf '%s %s\n' "$active_mono" "$retries" > "$retry_marker"
      else
        logger -t alt-pilot-watchdog "Account $slot restart could not be queued"
      fi
    fi
    continue
  fi
  miss_start=""; misses=0
  if [[ -r "$miss_marker" ]]; then
    read -r miss_start misses < "$miss_marker" || true
  fi
  [[ "$miss_start" == "$active_mono" && "$misses" =~ ^[0-9]+$ ]] || misses=0
  misses=$((misses + 1))
  printf '%s %s\n' "$active_mono" "$misses" > "$miss_marker"
  if (( misses < 2 )); then
    logger -t alt-pilot-watchdog "Account $slot lost its server connection; confirming before recovery"
    continue
  fi

  logger -t alt-pilot-watchdog "Account $slot remained disconnected; restarting $unit"
  rm -f "$miss_marker"
  systemctl try-restart --no-block "$unit" || logger -t alt-pilot-watchdog "Account $slot restart could not be queued"
done
