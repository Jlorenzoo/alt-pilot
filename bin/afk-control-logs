#!/usr/bin/env bash
# Fixed, read-only log view used by the unprivileged remote control service.
set -Eeuo pipefail
printf '%s\n' '--- Minecraft / MCC ---'
/usr/sbin/runuser -u mc -- tail -n 140 /opt/alt-pilot/logs/afk.log 2>/dev/null || true
for log in /opt/alt-pilot/logs/afk-{2..10}.log; do
  [[ -f "$log" ]] || continue
  printf '\n--- Account %s ---\n' "${log##*-}" | sed 's/\.log$//'
  /usr/sbin/runuser -u mc -- tail -n 80 "$log" 2>/dev/null || true
done
printf '%s\n' '--- Service events ---'
journalctl -u alt-pilot.service -u 'alt-pilot@*.service' --no-pager -n 60 -o short-iso 2>/dev/null || true
