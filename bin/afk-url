#!/usr/bin/env bash
# Print the persistent HTTPS endpoint; never substitute localhost or a temporary URL.
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
url=""
if [[ -f /etc/alt-pilot/dashboard-url ]]; then url="$(cat /etc/alt-pilot/dashboard-url)"; fi
if [[ -z "$url" ]] && command -v tailscale >/dev/null 2>&1; then
  url="$(tailscale funnel status --json 2>/dev/null | jq -r '(.AllowFunnel // {}) as $allowed | (.Web // {}) | to_entries[] | select($allowed[.key] == true) | select(.value.Handlers // {} | to_entries | any(.value.Proxy == "http://127.0.0.1:8765")) | .key' | head -1 | sed -E 's/:443$//' || true)"
  [[ -z "$url" ]] || url="https://$url"
fi
if [[ -z "$url" && -f "$root/.state/remote-access.json" ]]; then
  url="$(jq -r 'select(.temporary_url == false) | .url // empty' "$root/.state/remote-access.json")"
fi
if ! python3 - "$url" <<'PY'
import ipaddress,sys,urllib.parse
try:
    u=urllib.parse.urlsplit(sys.argv[1])
    if u.scheme != 'https' or u.username or u.password or u.port not in (None,443) or u.path not in ('','/') or u.query or u.fragment: raise ValueError()
    try: valid=ipaddress.IPv4Address(u.hostname).is_global
    except ValueError: valid=bool(u.hostname and u.hostname.endswith('.ts.net'))
    if not valid: raise ValueError()
except (ValueError,TypeError): raise SystemExit(1)
PY
then
  echo 'Your permanent dashboard link is not ready. Run the Cloud Shell installer again to finish setup.' >&2
  exit 1
fi
if [[ "${1:-}" == --raw || "${1:-}" == -r ]]; then printf '%s\n' "$url"; else
  printf 'Your ALT Pilot dashboard:\n  %s\n\nUse your dashboard password to sign in.\n' "$url"
fi
